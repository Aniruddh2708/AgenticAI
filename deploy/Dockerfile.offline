# Build with --build-context verified_wheels=.runtime/wheelhouse.
# The wheels must first be downloaded and checked against requirements.lock.
FROM python:3.11.14-slim-bookworm@sha256:65a93d69fa75478d554f4ad27c85c1e69fa184956261b4301ebaf6dbb0a3543d

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    VIBEFINANCE_STATE_DIR=/data \
    VIBEFINANCE_API_HOST=127.0.0.1 \
    VIBEFINANCE_API_PORT=8000 \
    VIBEFINANCE_DASHBOARD_HOST=0.0.0.0 \
    VIBEFINANCE_DASHBOARD_PORT=8501

WORKDIR /app
COPY requirements.lock ./requirements.lock
RUN --mount=type=bind,from=verified_wheels,target=/wheels \
    python -m pip install --no-index --find-links=/wheels --require-hashes -r requirements.lock \
    && groupadd --gid 10001 vibefinance \
    && useradd --uid 10001 --gid 10001 --create-home vibefinance \
    && mkdir /data \
    && chown vibefinance:vibefinance /data
COPY --chown=vibefinance:vibefinance vibefinance ./vibefinance
COPY --chown=vibefinance:vibefinance docs ./docs
USER vibefinance
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.getenv('VIBEFINANCE_DASHBOARD_PORT','8501')+'/_stcore/health',timeout=3)"
CMD ["python", "-m", "vibefinance.demo"]
